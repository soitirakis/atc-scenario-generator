{
  "name": "atc-scenario-generator",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "description": "En-route ATC radar training simulator with scenario and inject generation, built on real eAIP data for Romania (Bucharest ACC, LRBB) and Hungary (Budapest ACC, LHCC).",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:counts": "node scripts/test-counts.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "airac": "node scripts/airac-update.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "gifenc": "^1.0.3",
    "pdfjs-dist": "^6.5.438",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
